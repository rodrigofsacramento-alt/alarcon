# -----------------------------------------------------------------------------
# CAMINHOS ALTERNATIVOS DE ATIVOS (usados em verificações reversas)
# -----------------------------------------------------------------------------
# Pasta antiga (legado) — não usar para novos deploys
LEGACY_DOCROOT=/ahut-ecosystem/assets/
# Pasta ativa do cliente
ACTIVE_DOCROOT=/ahut/assets/
# Caminhos VPS de verificação
VPS_DOCROOT_HTML=/var/www/html/assets/
VPS_DOCROOT_CRM=/var/www/crm-imobiliaria/assets/